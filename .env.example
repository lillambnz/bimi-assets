NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/australian_healthcare
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRE=30d

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_password

# Medicare API (Mock)
MEDICARE_API_KEY=mock_medicare_api_key
MEDICARE_API_URL=https://api.medicare.gov.au/v1

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Australian Health Settings
MEDICARE_LEVY=2.0
BULK_BILLING_THRESHOLD=55000
PBS_SAFETY_NET=1633.80
